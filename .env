# Strapi CMS Configuration
NEXT_PUBLIC_CMS_URL=https://evadigitalcmsstag.evapharma.com/api/

# Fallback CMS URL (if primary is down)
# NEXT_PUBLIC_CMS_FALLBACK_URL=https://backup-cms.evapharma.com

# Optional: Add Strapi API Token if your API requires authentication
# NEXT_PUBLIC_STRAPI_API_TOKEN=your_api_token_here

# Development settings
NODE_ENV=development

# Optional: Enable detailed API logging
NEXT_PUBLIC_DEBUG_API=true

# Network configuration
NEXT_PUBLIC_CMS_TIMEOUT=60000
NEXT_PUBLIC_CMS_RETRY_COUNT=3

# Feature flags
NEXT_PUBLIC_ENABLE_FALLBACK_CONTENT=true
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true